NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://event_platform:event_platform@localhost:5432/event_platform?schema=public
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN_SECONDS=3600
QR_SIGNING_SECRET=replace-with-a-separate-32-character-secret
APP_PUBLIC_URL=http://localhost:3000
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW_MS=60000
TMDB_API_READ_TOKEN=replace-with-your-tmdb-api-read-access-token
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
TMDB_LANGUAGE=pt-BR
TMDB_REGION=BR
TMDB_TIMEOUT_MS=5000
