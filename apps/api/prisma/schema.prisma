generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ORGANIZER
  CUSTOMER
  GATE
}

enum ExternalProvider {
  TMDB
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELED
}

enum ReservationStatus {
  PENDING_PAYMENT
  PAID
  DECLINED
  EXPIRED
  CANCELED
}

enum PaymentStatus {
  APPROVED
  DECLINED
}

enum TicketStatus {
  VALID
  USED
  CANCELED
}

enum ValidationResult {
  VALID
  INVALID
  ALREADY_USED
  WRONG_EVENT
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @db.VarChar(100)
  email             String             @unique @db.VarChar(255)
  passwordHash      String             @map("password_hash") @db.VarChar(255)
  role              UserRole
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  organizedEvents   Event[]            @relation("EventOrganizer")
  reservations      Reservation[]
  tickets           Ticket[]           @relation("TicketCustomer")
  validatedTickets  Ticket[]           @relation("TicketValidator")
  ticketValidations TicketValidation[] @relation("GateValidationUser")

  @@map("users")
}

model Event {
  id                String             @id @default(uuid()) @db.Uuid
  organizerId       String             @map("organizer_id") @db.Uuid
  externalProvider  ExternalProvider   @map("external_provider")
  externalId        String             @map("external_id") @db.VarChar(100)
  sourceTitle       String             @map("source_title") @db.VarChar(200)
  title             String             @db.VarChar(120)
  description       String             @db.Text
  posterUrl         String?            @map("poster_url") @db.Text
  runtimeMinutes    Int?               @map("runtime_minutes")
  startsAt          DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime           @map("ends_at") @db.Timestamptz(3)
  timezone          String             @db.VarChar(64)
  venueName         String             @map("venue_name") @db.VarChar(160)
  address           String             @db.VarChar(255)
  city              String             @db.VarChar(120)
  priceCents        Int                @map("price_cents")
  capacity          Int
  availableQuantity Int                @map("available_quantity")
  status            EventStatus        @default(DRAFT)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  organizer         User               @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  reservations      Reservation[]
  tickets           Ticket[]
  validations       TicketValidation[]

  @@index([status, startsAt])
  @@index([organizerId, createdAt])
  @@map("events")
}

model Reservation {
  id                  String            @id @default(uuid()) @db.Uuid
  customerId          String            @map("customer_id") @db.Uuid
  eventId             String            @map("event_id") @db.Uuid
  quantity            Int
  unitPriceCents      Int               @map("unit_price_cents")
  totalPriceCents     Int               @map("total_price_cents")
  status              ReservationStatus @default(PENDING_PAYMENT)
  expiresAt           DateTime          @map("expires_at") @db.Timestamptz(3)
  inventoryReleasedAt DateTime?         @map("inventory_released_at") @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer            User              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  event               Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  payment             Payment?
  tickets             Ticket[]

  @@index([customerId, createdAt])
  @@index([eventId, status])
  @@index([status, expiresAt])
  @@map("reservations")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  reservationId  String        @unique @map("reservation_id") @db.Uuid
  amountCents    Int           @map("amount_cents")
  status         PaymentStatus
  idempotencyKey String        @unique @map("idempotency_key") @db.VarChar(128)
  requestHash    String        @map("request_hash") @db.Char(64)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  reservation    Reservation   @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@map("payments")
}

model Ticket {
  id             String             @id @default(uuid()) @db.Uuid
  reservationId  String             @map("reservation_id") @db.Uuid
  customerId     String             @map("customer_id") @db.Uuid
  eventId        String             @map("event_id") @db.Uuid
  sequence       Int
  status         TicketStatus       @default(VALID)
  qrNonceHash    String             @map("qr_nonce_hash") @db.Char(64)
  usedAt         DateTime?          @map("used_at") @db.Timestamptz(3)
  validatedById  String?            @map("validated_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  reservation    Reservation        @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  customer       User               @relation("TicketCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  event          Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  validatedBy    User?              @relation("TicketValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  shareLinks     ShareLink[]
  validations    TicketValidation[]

  @@unique([reservationId, sequence])
  @@index([customerId, status])
  @@index([eventId, status])
  @@map("tickets")
}

model ShareLink {
  id        String    @id @default(uuid()) @db.Uuid
  ticketId  String    @map("ticket_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, revokedAt])
  @@map("share_links")
}

model TicketValidation {
  id               String           @id @default(uuid()) @db.Uuid
  ticketId         String?          @map("ticket_id") @db.Uuid
  eventId          String           @map("event_id") @db.Uuid
  gateUserId       String           @map("gate_user_id") @db.Uuid
  tokenFingerprint String           @map("token_fingerprint") @db.Char(16)
  result           ValidationResult
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  ticket           Ticket?          @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  event            Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  gateUser         User             @relation("GateValidationUser", fields: [gateUserId], references: [id], onDelete: Restrict)

  @@index([eventId, createdAt])
  @@index([ticketId, createdAt])
  @@map("ticket_validations")
}
